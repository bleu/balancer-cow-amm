{
  "name": "balancer-cow-amm",
  "version": "1.4.0",
  "private": true,
  "description": "Balancer CoW AMM",
  "homepage": "https://github.com/balancer/cow-amm#readme",
  "bugs": {
    "url": "https://github.com/balancer/cow-amm/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/balancer/cow-amm.git"
  },
  "license": "GPL-3.0-or-later",
  "scripts": {
    "build": "forge build",
    "build:optimized": "FOUNDRY_PROFILE=optimized forge build",
    "coverage": "forge coverage --match-path 'test/unit/**'",
    "demo:deploy:base": "FOUNDRY_LINT_LINT_ON_BUILD=false forge build && node --env-file-if-exists=.env demo/deploy-base.mjs",
    "demo:local:deploy": "FOUNDRY_LINT_LINT_ON_BUILD=false forge build && node demo/local-deploy.mjs",
    "demo:probe:b20": "FOUNDRY_LINT_LINT_ON_BUILD=false forge build && node --env-file-if-exists=.env demo/probe-b20.mjs",
    "demo:serve": "node --env-file-if-exists=.env demo/server.mjs",
    "demo:serve:local": "node --env-file=.local/demo.env demo/server.mjs",
    "deploy:arbitrum": "forge script DeployBCoWFactory -vvvvv --rpc-url $ARBITRUM_RPC --broadcast --chain arbitrum --private-key $ARBITRUM_DEPLOYER_PK --verify",
    "deploy:gnosis": "forge script DeployBCoWFactory -vvvvv --rpc-url $GNOSIS_RPC --broadcast --chain gnosis --private-key $GNOSIS_DEPLOYER_PK --verify",
    "deploy:mainnet": "forge script DeployBCoWFactory -vvvvv --rpc-url $MAINNET_RPC --broadcast --chain mainnet --private-key $MAINNET_DEPLOYER_PK --verify",
    "deploy:testnet": "forge script DeployBCoWFactory -vvvvv --rpc-url $SEPOLIA_RPC --broadcast --chain sepolia --private-key $SEPOLIA_DEPLOYER_PK --verify",
    "lint:bulloak": "find test/unit -name '*.tree' | xargs bulloak check",
    "lint:check": "solhint 'src/**/*.sol' 'test/**/*.sol' 'script/**/*.sol' && forge fmt --check",
    "lint:fix": "solhint --fix 'src/**/*.sol' 'test/**/*.sol' 'script/**/*.sol' && sort-package-json && forge fmt",
    "lint:natspec": "pnpm exec natspec-smells --config natspec-smells.config.js",
    "local:auction": "FOUNDRY_LINT_LINT_ON_BUILD=false forge build && node script/local/auction.mjs run",
    "local:auction:verify": "node script/local/auction.mjs verify",
    "local:chain": "anvil --host 127.0.0.1 --port 8546 --chain-id 31338",
    "local:demo": "pnpm run local:deploy && pnpm run local:settle",
    "local:deploy": "FOUNDRY_LINT_LINT_ON_BUILD=false forge build && node script/local/m7.mjs deploy",
    "local:rebalance": "node script/local/m7.mjs rebalance",
    "local:settle": "node script/local/m7.mjs settle",
    "local:verify": "node script/local/m7.mjs verify",
    "prepare": "husky install",
    "script:gnosis": "forge script MainnetScript -vvvvv --rpc-url $GNOSIS_RPC --broadcast --chain gnosis --private-key $GNOSIS_DEPLOYER_PK --verify",
    "script:mainnet": "forge script MainnetScript -vvvvv --rpc-url $MAINNET_RPC --broadcast --chain mainnet --private-key $MAINNET_DEPLOYER_PK --verify",
    "script:testnet": "forge script TestnetScript -vvvvv --rpc-url $SEPOLIA_RPC --broadcast --chain sepolia --private-key $SEPOLIA_DEPLOYER_PK --verify",
    "smock": "smock-foundry --contracts src/contracts",
    "test": "pnpm test:integration && pnpm test:unit",
    "test:demo": "node --test demo/test/*.test.mjs",
    "test:demo:browser": "node demo/test/browser.mjs",
    "test:demo:local": "node --env-file=.local/demo.env demo/test/local-curator.mjs",
    "test:echidna": "find test/invariants/fuzz -regex '.*\\.t\\.sol$' |cut -d '/' -f 4 | cut -d . -f 1 |xargs -I{} echidna test/invariants/fuzz/{}.t.sol --contract Fuzz{} --config test/invariants/fuzz/{}.yaml",
    "test:integration": "forge test --ffi --match-path 'test/integration/**' -vvv --isolate",
    "test:local": "FOUNDRY_FUZZ_RUNS=100 forge test -vvv",
    "test:local:auction": "pnpm run local:auction",
    "test:local:curator": "FOUNDRY_LINT_LINT_ON_BUILD=false forge build && node script/local/curator-check.mjs",
    "test:local:protection": "pnpm run local:deploy && node script/local/m7.mjs protection",
    "test:local:rebalance": "pnpm run local:deploy && node script/local/m7.mjs rebalance --check",
    "test:local:settlement": "forge test --match-contract LocalSevenAssetCoWSettlementTest -vv",
    "test:scaffold": "bulloak check --fix test/unit/**/*.tree && forge fmt",
    "test:unit": "forge test --match-path 'test/unit/**' -vvv",
    "test:unit:deep": "FOUNDRY_FUZZ_RUNS=5000 pnpm test:unit"
  },
  "lint-staged": {
    "*.{js,css,md,ts,sol}": "forge fmt",
    "(src|script|test)/**/*.sol": "pnpm lint:check",
    "package.json": "sort-package-json"
  },
  "dependencies": {
    "@cowprotocol/contracts": "https://codeload.github.com/cowprotocol/contracts/tar.gz/a10f40788af29467e87de3dbf2196662b0a6b500",
    "@crytic/properties": "https://codeload.github.com/crytic/properties/tar.gz/f1ff61b8e90ce0c9ab138dfe23e80a8afa7f5e37",
    "@openzeppelin/contracts": "5.0.2",
    "composable-cow": "https://codeload.github.com/cowprotocol/composable-cow/tar.gz/24d556b634e21065e0ee70dd27469a6e699a8998",
    "cow-amm": "https://codeload.github.com/cowprotocol/cow-amm/tar.gz/6566128b6c73008062cf4a6d1957db602409b719",
    "solmate": "https://codeload.github.com/transmissions11/solmate/tar.gz/c892309933b25c03d32b1b0d674df7ae292ba925"
  },
  "devDependencies": {
    "@commitlint/cli": "19.3.0",
    "@commitlint/config-conventional": "19.2.2",
    "@defi-wonderland/natspec-smells": "1.1.3",
    "@defi-wonderland/smock-foundry": "1.5.0",
    "ethers": "5.8.0",
    "forge-gas-snapshot": "https://codeload.github.com/marktoda/forge-gas-snapshot/tar.gz/9161f7c0b6c6788a89081e2b3b9c67592b71e689",
    "forge-std": "https://codeload.github.com/foundry-rs/forge-std/tar.gz/978ac6fadb62f5f0b723c996f64be52eddba6801",
    "halmos-cheatcodes": "https://codeload.github.com/a16z/halmos-cheatcodes/tar.gz/c0d865508c0fee0a11b97732c5e90f9cad6b65a5",
    "husky": ">=8",
    "lint-staged": ">=10",
    "playwright": "1.65.1",
    "solhint-community": "4.0.0",
    "sort-package-json": "2.10.0"
  },
  "packageManager": "pnpm@10.3.0",
  "engines": {
    "node": ">=22.9.0",
    "pnpm": "10.x"
  }
}
