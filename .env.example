MAINNET_RPC=
MAINNET_DEPLOYER_PK=
GNOSIS_RPC=
GNOSIS_DEPLOYER_PK=
SEPOLIA_RPC=
SEPOLIA_DEPLOYER_PK=
ETHERSCAN_API_KEY=

# Demo configuration (Node 22.9+). All values have these defaults.
DEMO_HOST=127.0.0.1
DEMO_PORT=3000
DEMO_CHAIN_ID=56
DEMO_NETWORK_NAME=BNB Smart Chain
RPC_URL=https://bsc-rpc.publicnode.com
DEMO_EXPLORER_URL=https://bscscan.com
DEMO_FACTORY_ADDRESS=
CURATOR_ADDRESS=

# JSON arrays of {"address":"0x...","name":"MAG7"}; single quotes preserve JSON.
# Public listing and curator enrollment are separate, explicit operator actions.
DEMO_POOLS='[]'
CURATOR_POOLS='[]'

COW_API_URL=https://api.cow.fi/bnb/api/v1
CURATOR_INTERVAL_SECONDS=3600
CURATOR_ORDER_SECONDS=180
COINGECKO_MAX_AGE_SECONDS=1800
DEMO_SLIPPAGE_BPS=50
CURATOR_FEE_BPS=100
CURATOR_MIN_DRIFT_USD=0.10
CURATOR_LIMIT_BUFFER_BPS=10
CURATOR_MAX_SIZING_ATTEMPTS=8
DEMO_CONFIRMATIONS=2

# Server-only secrets; live posting is disabled unless explicitly enabled.
CURATOR_PRIVATE_KEY=
CURATOR_LIVE=false
COINGECKO_API_KEY=

# Local fixtures only; pnpm demo:local:deploy generates .local/demo.env.
# Asset metadata and synthetic price maps are JSON, forbidden on production networks.
DEMO_LOCAL_DEV=false
DEMO_LOCAL_ASSETS=
DEMO_FIXTURE_PRICES=

# Optional factory deployment; no broadcast without --broadcast.
DEPLOYER_ADDRESS=
DEPLOYER_PRIVATE_KEY=
FACTORY_ADMIN=
